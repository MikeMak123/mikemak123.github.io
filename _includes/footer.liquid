<style>
  .post .site-portrait {
    width: 22%;
    max-width: 200px;
    margin: 0 0 1.5rem 2rem;
  }
  .paper-entry {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
    gap: 1.5rem;
    align-items: start;
  }
  @media (max-width: 575px) {
    .post .site-portrait {
      float: none !important;
      width: 60%;
      max-width: 180px;
      margin: 0 auto 1.75rem;
    }
    .paper-entry {
      grid-template-columns: minmax(0, 1fr);
      gap: 1rem;
    }
  }
  body {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    padding-bottom: 0;
    margin-bottom: 0;
  }
  body > [role='main'] {
    flex: 1 0 auto;
  }
  .site-contact-footer .social {
    margin: 0;
  }
</style>
<footer class="site-contact-footer" role="contentinfo" style="position: static; flex-shrink: 0; background: transparent; padding: 1.5rem 0;">
  <div class="container">
    {% if site.data.socials %}
      <div class="social">
        <div class="contact-icons" style="font-size: 1.75rem; display: flex; align-items: center; justify-content: center; gap: 1rem;">
          <a href="{{ site.data.socials.cv_pdf | relative_url }}" title="CV" aria-label="CV">
            <i class="ai ai-cv" aria-hidden="true"></i>
          </a>
          <a href="mailto:{{ site.data.socials.email }}" title="Email" aria-label="Email">
            <i class="fa-solid fa-envelope" aria-hidden="true"></i>
          </a>
          {% if site.data.socials.scholar_userid %}
            <a
              href="https://scholar.google.com/citations?user={{ site.data.socials.scholar_userid | url_encode }}"
              title="Google Scholar"
              aria-label="Google Scholar"
            >
              <i class="ai ai-google-scholar" aria-hidden="true"></i>
            </a>
          {% else %}
            <span
              role="img"
              aria-label="Google Scholar (coming soon)"
              title="Google Scholar (coming soon)"
              style="opacity: 0.45; cursor: default;"
            >
              <i class="ai ai-google-scholar" aria-hidden="true"></i>
            </span>
          {% endif %}
          <a href="https://www.linkedin.com/in/{{ site.data.socials.linkedin_username }}/" title="LinkedIn" aria-label="LinkedIn">
            <i class="fa-brands fa-linkedin" aria-hidden="true"></i>
          </a>
          <a href="https://github.com/{{ site.data.socials.github_username }}" title="GitHub" aria-label="GitHub">
            <i class="fa-brands fa-github" aria-hidden="true"></i>
          </a>
        </div>
        {% if site.contact_note %}
          <div class="contact-note">{{ site.contact_note }}</div>
        {% endif %}
      </div>
    {% endif %}
    <div class="copyright" style="margin-top: 1rem; text-align: center; font-size: 0.8rem;">
      &copy; Copyright {{ site.time | date: '%Y' }}
      {{ site.first_name }}
      {{ site.last_name }}.
    </div>
  </div>
</footer>
