<div class="row">
  {% if entry.preview %}
    <div class="col-sm-4" style="margin-bottom: 1rem;">
      <img
        src="{{ entry.preview | prepend: '/assets/img/publication_preview/' | relative_url }}"
        alt="{{ entry.title }}"
        width="1672"
        height="941"
        loading="lazy"
        style="display: block; width: 100%; height: auto; object-fit: contain; border-radius: 6px;"
      >
    </div>
  {% endif %}
  <div class="{% if entry.preview %}col-sm-8{% else %}col-sm-12{% endif %}">
    <div class="title">{{ entry.title }}</div>
    <div class="author">
      {% for author in entry.author_array %}
        {{- author.first }}
        {{ author.last -}}
        {%- unless forloop.last %}, {% endunless -%}
      {% endfor %}
    </div>
    <div class="periodical">{{ entry.booktitle }}, {{ entry.year }}</div>
  </div>
</div>
