<div class="row">
  <div class="col-sm-12">
    <div class="title">{{ entry.title }}</div>
    <div class="author">
      {% for author in entry.author_array %}
        {{- author.first }}
        {{ author.last -}}
        {%- unless forloop.last %}, {% endunless -%}
      {% endfor %}
    </div>
    <div class="periodical">{{ entry.booktitle }}, {{ entry.year }}</div>
  </div>
</div>
