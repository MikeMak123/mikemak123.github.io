---
layout: default
---
<div class="post">
  <header class="post-header">
    <h1 class="post-title">
      {% if site.title == 'blank' %}
        <span class="font-weight-bold">{{ site.first_name }}</span> {{ site.middle_name }}
        {{ site.last_name }}
      {% else %}
        {{ site.title }}
      {% endif %}
    </h1>
    <p class="chinese-name" style="margin-top: -0.25rem; font-size: 1.15rem; font-weight: 400; opacity: 0.6;">（麦凯翔）</p>
    {% if page.subtitle %}
      <p class="desc">{{ page.subtitle }}</p>
    {% endif %}
  </header>
  <article>
    {% assign profile_image_path = page.profile.image | prepend: 'assets/img/' %}
    {% capture profile_image_exists %}{% file_exists {{ profile_image_path }} %}{% endcapture %}
    {% if profile_image_exists == 'true' or page.profile.more_info %}
      <div class="profile float-{{ page.profile.align | default: 'right' }}" style="width: 22%; max-width: 200px;">
        {% if page.profile.image and profile_image_exists == 'true' %}
          {% assign profile_image_class = 'img-fluid z-depth-1 rounded' %}
          {% if page.profile.image_circular %}
            {% assign profile_image_class = 'img-fluid z-depth-1 rounded-circle' %}
          {% endif %}
          <img
            src="{{ profile_image_path | relative_url }}"
            alt="{{ site.first_name }} {{ site.last_name }}"
            class="{{ profile_image_class }}"
            width="{{ page.profile.image_width }}"
            height="{{ page.profile.image_height }}"
            style="display: block; width: 100%; height: auto; object-fit: contain;"
            loading="eager"
          >
        {% endif %}
        {% if page.profile.more_info %}
          <div class="more-info">{{ page.profile.more_info }}</div>
        {% endif %}
      </div>
    {% endif %}
    <div class="clearfix">{{ content }}</div>

    {% if page.announcements.enabled %}
      <h2><a href="{{ '/news/' | relative_url }}" style="color: inherit">news</a></h2>
      {% include news.liquid limit=true %}
    {% endif %}
    {% if page.latest_posts.enabled %}
      <h2><a href="{{ '/blog/' | relative_url }}" style="color: inherit">latest posts</a></h2>
      {% include latest_posts.liquid %}
    {% endif %}
    {% if page.selected_papers %}
      <h2><a href="{{ '/publications/' | relative_url }}" style="color: inherit">selected publications</a></h2>
      {% include selected_papers.liquid %}
    {% endif %}
  </article>
</div>
