---
layout: default
---
<div class="post">
  <header class="post-header">
    <h1 class="post-title">
      {% if site.title == 'blank' %}
        <span class="font-weight-bold">{{ site.first_name }}</span> {{ site.middle_name }}
        {{ site.last_name }}
      {% else %}
        {{ site.title }}
      {% endif %}
    </h1>
    {% if page.subtitle %}
      <p class="desc">{{ page.subtitle }}</p>
    {% endif %}
  </header>
  <article>
    {% assign profile_image_path = page.profile.image | prepend: 'assets/img/' %}
    {% capture profile_image_exists %}{% file_exists {{ profile_image_path }} %}{% endcapture %}
    {% if profile_image_exists == 'true' or page.profile.more_info %}
      <div class="profile float-{{ page.profile.align | default: 'right' }}">
        {% if page.profile.image and profile_image_exists == 'true' %}
          {% assign profile_image_class = 'img-fluid z-depth-1 rounded' %}
          {% if page.profile.image_circular %}
            {% assign profile_image_class = 'img-fluid z-depth-1 rounded-circle' %}
          {% endif %}
          {% include figure.liquid loading="eager" path=profile_image_path class=profile_image_class alt=site.first_name cache_bust=true %}
        {% endif %}
        {% if page.profile.more_info %}
          <div class="more-info">{{ page.profile.more_info }}</div>
        {% endif %}
      </div>
    {% endif %}
    <div class="clearfix">{{ content }}</div>

    {% if page.announcements.enabled %}
      <h2><a href="{{ '/news/' | relative_url }}" style="color: inherit">news</a></h2>
      {% include news.liquid limit=true %}
    {% endif %}
    {% if page.latest_posts.enabled %}
      <h2><a href="{{ '/blog/' | relative_url }}" style="color: inherit">latest posts</a></h2>
      {% include latest_posts.liquid %}
    {% endif %}
    {% if page.selected_papers %}
      <h2><a href="{{ '/publications/' | relative_url }}" style="color: inherit">selected publications</a></h2>
      {% include selected_papers.liquid %}
    {% endif %}

    {% if page.social %}
      <div class="social">
        <div class="contact-icons">
          <a href="{{ site.data.socials.cv_pdf | relative_url }}" title="CV" aria-label="CV">
            <i class="ai ai-cv" aria-hidden="true"></i>
          </a>
          <a href="mailto:{{ site.data.socials.email }}" title="Email" aria-label="Email">
            <i class="fa-solid fa-envelope" aria-hidden="true"></i>
          </a>
          {% if site.data.socials.scholar_userid %}
            <a
              href="https://scholar.google.com/citations?user={{ site.data.socials.scholar_userid | url_encode }}"
              title="Google Scholar"
              aria-label="Google Scholar"
            >
              <i class="ai ai-google-scholar" aria-hidden="true"></i>
            </a>
          {% else %}
            <span
              role="img"
              aria-label="Google Scholar (coming soon)"
              title="Google Scholar (coming soon)"
              style="opacity: 0.45; cursor: default;"
            >
              <i class="ai ai-google-scholar" aria-hidden="true"></i>
            </span>
          {% endif %}
          <a href="https://www.linkedin.com/in/{{ site.data.socials.linkedin_username }}/" title="LinkedIn" aria-label="LinkedIn">
            <i class="fa-brands fa-linkedin" aria-hidden="true"></i>
          </a>
        </div>
        {% if site.contact_note %}
          <div class="contact-note">{{ site.contact_note }}</div>
        {% endif %}
      </div>
    {% endif %}
  </article>
</div>
